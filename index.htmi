<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBTI로 포켓몬 찾기</title>
    <style>
        /* 기본 스타일 및 색상 설정 */
        body {
            font-family: 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
            background: linear-gradient(135deg, #FFB6C1, #87CEEB); /* 포근한 핑크와 하늘색 */
            min-height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #333;
        }
        .container {
            background: white;
            padding: 40px 30px;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            width: 90%;
            max-width: 500px;
            box-sizing: border-box;
        }
        h1 {
            font-size: 2.2rem;
            color: #333;
            word-break: keep-all;
            margin-bottom: 10px;
        }
        h2 {
            font-size: 1.8rem;
            color: #555;
            word-break: keep-all;
            line-height: 1.4;
            margin-bottom: 30px;
        }
        p {
            font-size: 1.2rem;
            line-height: 1.6;
        }
        
        /* 버튼 스타일 */
        .btn {
            background: #87CEEB; /* 하늘색 */
            color: white;
            border: none;
            padding: 20px;
            margin: 10px 0;
            border-radius: 20px;
            font-size: 1.3rem;
            cursor: pointer;
            transition: background 0.3s, transform 0.1s;
            width: 100%;
            box-sizing: border-box;
            font-weight: bold;
            word-break: keep-all;
        }
        .btn:hover {
            background: #FFB6C1; /* 마우스 오버시 핑크색 */
        }
        .btn:active {
            transform: scale(0.98);
        }
        
        /* 숨김 처리 */
        .hidden {
            display: none;
        }

        /* 결과 화면 스타일 */
        .mbti-title {
            font-size: 1.5rem;
            color: #888;
            margin: 0;
        }
        .pokemon-name {
            font-size: 2.5rem;
            color: #FF69B4; /* 진한 핑크 */
            font-weight: bold;
            margin: 15px 0 5px;
        }
        .pokemon-type {
            font-size: 1.2rem;
            color: #87CEEB;
            font-weight: bold;
            margin-bottom: 20px;
        }
        .desc-box {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 20px;
            margin: 20px 0;
            text-align: left;
        }
        .desc-box p {
            margin: 10px 0;
            font-size: 1.15rem;
        }
        .match-box {
            border: 3px dashed #87CEEB;
            padding: 20px;
            border-radius: 20px;
            margin: 25px 0;
            background: #f0f8ff;
        }
        .match-box h3 {
            margin: 0 0 10px 0;
            color: #333;
            font-size: 1.3rem;
        }
        .match-box p {
            margin: 0;
            font-size: 1.2rem;
            font-weight: bold;
            color: #FF69B4;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- 시작 화면 -->
    <div id="intro-screen">
        <h1>🔍 MBTI로 알아보는<br>나와 닮은 포켓몬</h1>
        <p>나의 성격과 가장 잘 어울리는 포켓몬은 누구일까요? 4개의 간단한 질문으로 알아보세요!</p>
        <button class="btn" onclick="startTest()">테스트 시작하기</button>
    </div>

    <!-- 질문 화면 -->
    <div id="quiz-screen" class="hidden">
        <h2 id="question-text">질문이 여기에 표시됩니다.</h2>
        <button class="btn" id="btn-a" onclick="selectAnswer('A')">답변 A</button>
        <button class="btn" id="btn-b" onclick="selectAnswer('B')">답변 B</button>
    </div>

    <!-- 결과 화면 -->
    <div id="result-screen" class="hidden">
        <p class="mbti-title">당신의 MBTI는 <strong id="res-mbti"></strong></p>
        <div class="pokemon-name" id="res-name">포켓몬 이름</div>
        <div class="pokemon-type" id="res-type">포켓몬 타입</div>
        
        <div class="desc-box">
            <p><strong>📖 설명:</strong> <span id="res-desc"></span></p>
            <p><strong>✨ 어울리는 이유:</strong> <span id="res-reason"></span></p>
        </div>

        <div class="match-box">
            <h3>💖 환상의 찰떡궁합</h3>
            <p id="res-partner">MBTI - 포켓몬</p>
        </div>

        <button class="btn" onclick="resetTest()">다시 고르기</button>
    </div>
</div>

<script>
    // 질문 데이터
    const questions = [
        { 
            q: "주말에 시간이 생겼다! 나는?", 
            a: "친구들과 밖에서 신나게 논다", aType: "E", 
            b: "집에서 혼자 푹 쉬며 에너지를 충전한다", bType: "I" 
        },
        { 
            q: "무언가를 배울 때 나는?", 
            a: "설명서와 규칙을 꼼꼼하게 따라간다", aType: "S", 
            b: "내 직감과 상상력을 발휘해서 해본다", bType: "N" 
        },
        { 
            q: "친구가 '나 우울해서 화분 샀어'라고 한다면?", 
            a: "무슨 화분 샀어? (혹은) 왜 우울해?", aType: "T", 
            b: "많이 우울했구나 ㅠㅠ 지금은 좀 어때?", bType: "F" 
        },
        { 
            q: "여행을 떠나기 전날 밤, 나는?", 
            a: "일정표를 다시 확인하고 짐을 완벽히 싼다", aType: "J", 
            b: "가서 뭐 할지 대충 생각하고 마음 편히 잔다", bType: "P" 
        }
    ];

    // 포켓몬 16가지 결과 데이터
    const mbtiData = {
        "ISTJ": { name: "꼬부기 🐢", type: "물 타입", desc: "듬직하고 성실한 꼬마 거북이 포켓몬", reason: "묵묵하고 성실하게 제 할 일을 다하는 책임감 넘치는 모습이 꼬부기의 든든함과 찰떡이에요.", partner: "ESFP", partnerPoke: "토게피 🥚" },
        "ISFJ": { name: "이상해씨 🐸", type: "풀/독 타입", desc: "등에 씨앗을 품고 다니는 다정한 포켓몬", reason: "다른 사람들을 배려하는 따뜻한 마음이 씨앗을 정성껏 키우는 이상해씨와 닮았어요.", partner: "ESTP", partnerPoke: "꼬마돌 🪨" },
        "INFJ": { name: "가디안 🧚‍♀️", type: "에스퍼/페어리 타입", desc: "소중한 사람을 지키려는 포옹력 포켓몬", reason: "뛰어난 통찰력과 이상을 품고 있으며, 누군가를 지키려는 따뜻한 마음씨가 꼭 닮았어요.", partner: "ENFP", partnerPoke: "이브이 🦊" },
        "INTJ": { name: "뮤츠 🔮", type: "에스퍼 타입", desc: "압도적인 힘을 가진 유전공학 포켓몬", reason: "냉철한 판단력과 지능으로 목표를 향해 완벽을 추구하는 모습이 카리스마 넘치는 뮤츠 같아요.", partner: "ENTP", partnerPoke: "팬텀 👻" },
        "ISTP": { name: "잠만보 💤", type: "노말 타입", desc: "먹고 자는 것을 좋아하는 졸음 포켓몬", reason: "평소엔 무심하고 느긋해 보이지만, 진짜 필요할 때는 엄청난 에너지를 발휘하는 현실주의자예요.", partner: "ESFJ", partnerPoke: "내루미 👅" },
        "ISFP": { name: "푸린 🎤", type: "노말/페어리 타입", desc: "노래 부르기를 좋아하는 풍선 포켓몬", reason: "온화하고 예술적인 감수성이 풍부하며, 부드러운 매력으로 사람들의 마음을 편안하게 해줘요.", partner: "ESTJ", partnerPoke: "롱스톤 ⛰️" },
        "INFP": { name: "메타몽 💟", type: "노말 타입", desc: "무엇으로든 변신할 수 있는 포켓몬", reason: "유연한 사고와 풍부한 상상력을 가졌으며, 타인을 이해하고 공감하는 잠재력이 무궁무진해요.", partner: "ENFJ", partnerPoke: "망나뇽 🐉" },
        "INTP": { name: "야돈 🦥", type: "물/에스퍼 타입", desc: "멍하니 생각에 잠기는 얼간이 포켓몬", reason: "겉으로는 멍해 보일지 몰라도, 머릿속은 온갖 호기심과 논리적인 탐구로 바쁘게 돌아가고 있어요.", partner: "ENTJ", partnerPoke: "리자몽 🔥" },
        "ESTP": { name: "꼬마돌 🪨", type: "바위/땅 타입", desc: "에너지가 넘치고 튼튼한 암석 포켓몬", reason: "활동적이고 모험을 즐기며, 어떤 상황이든 직접 부딪히고 해결해 나가는 강한 실천력이 있어요.", partner: "ISFJ", partnerPoke: "이상해씨 🐸" },
        "ESFP": { name: "토게피 🥚", type: "페어리 타입", desc: "사람들에게 행운과 웃음을 주는 포켓몬", reason: "밝고 명랑한 성격으로 주변 사람들에게 항상 긍정적인 에너지를 전파하는 최고의 분위기 메이커예요.", partner: "ISTJ", partnerPoke: "꼬부기 🐢" },
        "ENFP": { name: "이브이 🦊", type: "노말 타입", desc: "다양한 진화 가능성을 가진 포켓몬", reason: "호기심이 넘치고 열정적이며, 틀에 얽매이지 않고 매일매일 새로운 경험을 찾아 떠나는 걸 좋아해요.", partner: "INFJ", partnerPoke: "가디안 🧚‍♀️" },
        "ENTP": { name: "팬텀 👻", type: "고스트/독 타입", desc: "장난기 가득한 매력적인 그림자 포켓몬", reason: "독창적인 아이디어와 재치 있는 입담으로 사람들을 깜짝 놀라게 만드는 매력적인 장난꾸러기예요.", partner: "INTJ", partnerPoke: "뮤츠 🔮" },
        "ESTJ": { name: "롱스톤 ⛰️", type: "바위/땅 타입", desc: "튼튼하고 거대한 바위뱀 포켓몬", reason: "확고한 규칙과 질서를 중요하게 생각하며, 한번 결정한 일은 끝까지 밀고 나가는 듬직한 리더예요.", partner: "ISFP", partnerPoke: "푸린 🎤" },
        "ESFJ": { name: "내루미 👅", type: "노말 타입", desc: "다정하고 애교가 많은 핥기 포켓몬", reason: "사람들을 돕고 챙겨주는 것을 진심으로 즐기며, 누구와도 금방 친해지는 엄청난 친화력을 가졌어요.", partner: "ISTP", partnerPoke: "잠만보 💤" },
        "ENFJ": { name: "망나뇽 🐉", type: "드래곤/비행 타입", desc: "바다를 누비는 다정한 드래곤 포켓몬", reason: "따뜻한 카리스마로 사람들을 이끌며, 어려움에 처한 사람을 지나치지 않고 도와주는 다정한 리더예요.", partner: "INFP", partnerPoke: "메타몽 💟" },
        "ENTJ": { name: "리자몽 🔥", type: "불꽃/비행 타입", desc: "뜨거운 열정을 품은 화염 포켓몬", reason: "당당하고 자신감 넘치며, 거침없는 추진력과 카리스마로 사람들을 이끌고 목표를 쟁취해내요.", partner: "INTP", partnerPoke: "야돈 🦥" }
    };

    let currentQ = 0;
    let scores = { E:0, I:0, S:0, N:0, T:0, F:0, J:0, P:0 };

    // 테스트 시작
    function startTest() {
        document.getElementById('intro-screen').classList.add('hidden');
        document.getElementById('quiz-screen').classList.remove('hidden');
        showQuestion();
    }

    // 질문 보여주기
    function showQuestion() {
        if (currentQ >= questions.length) {
            calculateResult();
            return;
        }
        const qData = questions[currentQ];
        document.getElementById('question-text').innerText = qData.q;
        
        const btnA = document.getElementById('btn-a');
        const btnB = document.getElementById('btn-b');
        
        btnA.innerText = qData.a;
        btnB.innerText = qData.b;
        
        // 이전 이벤트 리스너 덮어쓰기 위해 onclick 속성 직접 변경
        btnA.onclick = function() { selectAnswer(qData.aType); };
        btnB.onclick = function() { selectAnswer(qData.bType); };
    }

    // 답변 선택 시
    function selectAnswer(type) {
        scores[type]++;
        currentQ++;
        showQuestion();
    }

    // 결과 계산 및 화면 표시
    function calculateResult() {
        document.getElementById('quiz-screen').classList.add('hidden');
        
        // MBTI 조합 계산
        const mbti = (scores.E > scores.I ? "E" : "I") +
                     (scores.S > scores.N ? "S" : "N") +
                     (scores.T > scores.F ? "T" : "F") +
                     (scores.J > scores.P ? "J" : "P");

        const resultData = mbtiData[mbti];

        document.getElementById('res-mbti').innerText = mbti;
        document.getElementById('res-name').innerText = resultData.name;
        document.getElementById('res-type').innerText = resultData.type;
        document.getElementById('res-desc').innerText = resultData.desc;
        document.getElementById('res-reason').innerText = resultData.reason;
        document.getElementById('res-partner').innerText = `${resultData.partner} (${resultData.partnerPoke})`;

        document.getElementById('result-screen').classList.remove('hidden');
    }

    // 테스트 초기화 (다시 고르기)
    function resetTest() {
        currentQ = 0;
        scores = { E:0, I:0, S:0, N:0, T:0, F:0, J:0, P:0 };
        document.getElementById('result-screen').classList.add('hidden');
        document.getElementById('intro-screen').classList.remove('hidden');
    }
</script>
</body>
</html>
